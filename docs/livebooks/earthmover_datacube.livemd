```elixir
# Generate synthetic satellite imagery data
# Simulates realistic patterns: spatial autocorrelation, seasonal variation, spectral characteristics

defmodule DatacubeGenerator do
  @moduledoc """
  Generate synthetic multi-spectral satellite imagery (Nx-vectorized).
  """

  def generate_datacube(time_steps, bands, height, width) do
    IO.puts("Generating synthetic datacube data...")

    for t <- 0..(time_steps - 1) do
      IO.write("\rGenerating month #{t + 1}/#{time_steps}...")

      # Generate all bands for this time step
      band_data =
        for b <- 0..(bands - 1) do
          generate_band(t, b, height, width)
        end
        |> Nx.stack()

      band_data
    end
    |> Nx.stack()
    |> tap(fn _ -> IO.puts(" Done!") end)
  end

  defp generate_band(time, band, height, width) do
    base_value = band_base_value(band) * 1.0
    seasonal_factor = seasonal_variation(time, band)

    y_idx = Nx.iota({height, width}, axis: 0) |> Nx.as_type({:f, 32})
    x_idx = Nx.iota({height, width}, axis: 1) |> Nx.as_type({:f, 32})

    terrain =
      y_idx
      |> Nx.multiply(:math.pi() / 100)
      |> Nx.sin()
      |> Nx.multiply(x_idx |> Nx.multiply(:math.pi() / 100) |> Nx.cos())

    patches =
      y_idx
      |> Nx.multiply(:math.pi() / 25)
      |> Nx.sin()
      |> Nx.multiply(x_idx |> Nx.multiply(:math.pi() / 25) |> Nx.sin())

    key = Nx.Random.key(time * 17 + band + 1)
    {noise, _} = Nx.Random.uniform(key, shape: {height, width}, type: {:f, 32})
    noise = noise |> Nx.subtract(0.5) |> Nx.multiply(500.0)

    base_value
    |> Nx.add(Nx.multiply(Nx.divide(y_idx, height * 1.0), 2000.0))
    |> Nx.add(Nx.multiply(Nx.divide(x_idx, width * 1.0), 1000.0))
    |> Nx.add(Nx.multiply(terrain, 3000.0))
    |> Nx.add(Nx.multiply(patches, 2000.0))
    |> Nx.add(seasonal_factor * 5000.0)
    |> Nx.add(noise)
    |> Nx.max(0.0)
    |> Nx.min(65_535.0)
    |> Nx.round()
    |> Nx.as_type({:u, 16})
  end

  defp band_base_value(0), do: 8000
  defp band_base_value(1), do: 10_000
  defp band_base_value(2), do: 7000
  defp band_base_value(3), do: 15_000

  defp seasonal_variation(month, band) do
    angle = month * :math.pi() / 6

    case band do
      0 -> -:math.cos(angle) * 0.3
      3 -> :math.cos(angle) * 0.5
      _ -> :math.cos(angle) * 0.1
    end
  end
end

# Generate and write data
datacube_data =
  DatacubeGenerator.generate_datacube(time_steps, bands, height, width)

DatacubeHelpers.write_tensor!(datacube, datacube_data)

IO.puts("\nDatacube populated with synthetic satellite imagery")
IO.puts("Data type: #{inspect(Nx.type(datacube_data))}")
IO.puts("Data shape: #{inspect(Nx.shape(datacube_data))}")
