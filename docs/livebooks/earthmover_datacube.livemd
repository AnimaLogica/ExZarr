**Key Observations:**

1. **Chunk-by-chunk processing** enables computation on large datasets
2. **Spatial chunking** optimizes for region-based queries
3. **Temporal chunking** optimizes for time series analysis
4. **Zone-based aggregation** reduces many pixels to summary statistics

> Stop any still-running old `compute_temporal_mean` cell, then re-evaluate from
> the datacube-creation cells (shape is now 128×128; mean uses `stream_chunks`).

## Visualization: Spatial Map

Visualize a spatial slice of the datacube using VegaLite.

```elixir
alias VegaLite, as: Vl

# Extract spatial slice via stream_chunks (avoids slow 4D get_slice assembly)
last_time = time_steps - 1
{_t_c, _b_c, y_c, x_c} = metadata.chunks

spatial_2d =
  datacube
  |> ExZarr.Array.stream_chunks(
    concurrency: 4,
    ordered: false,
    filter: fn
      {^last_time, _b, _y, _x} -> true
      _ -> false
    end
  )
  |> Enum.reduce(Nx.broadcast(0, {height, width}) |> Nx.as_type({:u, 16}), fn
    {{_t, _b, y_i, x_i}, binary}, acc ->
      tile =
        binary
        |> Nx.from_binary({:u, 16})
        |> Nx.reshape({4, y_c, x_c})

      Nx.put_slice(acc, [y_i * y_c, x_i * x_c], tile[0])
  end)

# Downsample for visualization
downsample_factor = 4
viz_height = div(height, downsample_factor)
viz_width = div(width, downsample_factor)

viz_data =
  for y <- 0..(viz_height - 1), x <- 0..(viz_width - 1) do
    orig_y = y * downsample_factor
    orig_x = x * downsample_factor
    value = Nx.to_number(spatial_2d[[orig_y, orig_x]])

    %{x: x, y: y, value: value}
  end

Vl.new(width: 500, height: 500, title: "Red Band - Month 12 (Downsampled 4x)")
|> Vl.data_from_values(viz_data)
|> Vl.mark(:rect)
|> Vl.encode_field(:x, "x", type: :ordinal, title: "X (pixels / 4)")
|> Vl.encode_field(:y, "y", type: :ordinal, title: "Y (pixels / 4)", sort: "descending")
|> Vl.encode_field(:color, "value",
  type: :quantitative,
  scale: [scheme: "viridis"],
  title: "DN"
)
```

